# Variant of default.conf.template for this server, where host-nginx owns
# ports 80/443 (it already fronts munsify.com and api.dinedecider.pk). TLS is
# terminated by host-nginx, which proxies to 127.0.0.1:8100 over plain HTTP;
# this container therefore serves the app on :80 and does NOT redirect to
# https - the shipped template's 301 would loop behind that proxy.
#
# Mounted over the default template by docker-compose.override.yml.

upstream php-fpm {
    server app:9000;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_SERVER_NAME};

    # Same liveness probe the compose healthcheck hits.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "same-origin" always;

    root /var/www/html/public;
    index index.php;

    charset utf-8;

    client_max_body_size 20M;

    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/index\.php$ {
        fastcgi_pass php-fpm;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 90s;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
