[mysqld]
# Every record hash is computed over text, and a collation difference between
# two servers would make identical rows compare unequal. Pin both explicitly.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Timestamps are stored UTC-naive by the application (app/Support/BusinessDate).
# The server must not helpfully convert them.
default-time-zone = '+00:00'

# Sized for the 1 GB VPS in DEPLOYMENT_WEB.md §2. The whole pharmacy dataset is
# small enough to sit in this pool, which is what makes the derived-stock SUM()
# queries cheap.
innodb_buffer_pool_size = 256M

# Every sale is money. Flush the log at each commit, even though it costs
# throughput: the alternative is losing up to a second of transactions on power
# loss, and "the till is out by one sale" is exactly the failure this system
# exists to prevent.
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1

max_connections = 60

# ONLY_FULL_GROUP_BY stays on: the stock aggregation queries must be explicit
# about what they group by, or a wrong quantity can slip through silently.
sql_mode = "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

# STRICT_TRANS_TABLES turns a silently truncated decimal into an error. On a
# money column, silence is the dangerous option.

slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1
