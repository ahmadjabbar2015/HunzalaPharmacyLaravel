# Copy to .env, then fill in the four values marked CHANGE ME.
#
#   cp .env.docker.example .env
#   docker compose run --rm app php artisan key:generate --show   # -> APP_KEY
#   docker compose up -d --build

APP_NAME="HunZala Pharmacy"
APP_ENV=production

# CHANGE ME. Generate with the command above. Without it every session cookie
# and every encrypted column is unreadable after a restart.
APP_KEY=

# Never true on the shop's server: Laravel's debug page prints database
# credentials and query contents to anyone who triggers an error.
APP_DEBUG=false

# CHANGE ME to the real domain. Used for generated links, and it must match
# NGINX_SERVER_NAME or TLS will not validate.
APP_URL=https://pharmacy.example.com

APP_TIMEZONE=UTC
APP_LOCALE=en

# ---------------------------------------------------------------------------
# The device prefix stamped on origin_device_id and on every invoice and PO
# number (WEB-20260927-0001). Two installs must never share one, or they can
# mint the same invoice number. Leave as WEB for a single web deployment.
# ---------------------------------------------------------------------------
PHARMACY_DEVICE_ID=WEB

# ---------------------------------------------------------------------------
# Database. The host is the compose service name, not localhost.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hunzala_pharmacy
DB_USERNAME=pharmacy

# CHANGE ME both. The application uses DB_PASSWORD; DB_ROOT_PASSWORD is only
# for `docker compose exec mysql` and for restores.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache and queue.
#
# Sessions live in the database, not redis: a logged-in manager must not be
# thrown out because the cache was flushed.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Staff log in over HTTPS only, so the cookie may be secure-only.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Logging. stderr so `docker compose logs app` is the one place to look.
# ---------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# TLS. Must match APP_URL's host.
# ---------------------------------------------------------------------------
NGINX_SERVER_NAME=pharmacy.example.com
CERTBOT_EMAIL=owner@example.com

# ---------------------------------------------------------------------------
# Backups - written to ./backups on the host. Copy them OFF the server.
# ---------------------------------------------------------------------------
BACKUP_HOUR=3
BACKUP_RETAIN_DAYS=30
